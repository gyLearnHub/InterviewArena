APP_ENV=development
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?charset=utf8mb4
MYSQL_POOL_SIZE=10
MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=5
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_WRITE_TIMEOUT_SECONDS=30
STORAGE_BACKEND=local
DEPLOYMENT_REPLICA_COUNT=1
# 多副本时设为 shared_filesystem，并把下面两个目录配置为该共享卷内的绝对路径。
SHARED_STORAGE_ROOT=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_RETRY_COUNT=2

UPLOAD_DIR=resume
AVATAR_UPLOAD_DIR=uploads/avatars

CHROMA_ENABLED=false
CHROMA_PERSIST_DIR=chromadb

EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

MEMORY_TASK_POLL_SECONDS=5
MEMORY_TASK_MAX_RETRIES=3
MEMORY_TASK_PROCESSING_TIMEOUT_SECONDS=900
MEMORY_QUERY_TIMEOUT_SECONDS=3
MEMORY_RETRIEVAL_TIMEOUT_SECONDS=4
MEMORY_ENABLED_DEFAULT=true
MEMORY_MIN_RELEVANCE_SCORE=0.15

# Active-interview short-term memory. MySQL remains the rebuild source.
REDIS_URL=redis://127.0.0.1:6379/0
SHORT_MEMORY_TTL_SECONDS=604800
SHORT_MEMORY_RECENT_QA_LIMIT=5
SHORT_MEMORY_TOKEN_BUDGET=8000
SHORT_MEMORY_REDIS_TIMEOUT_SECONDS=1

USAGE_LIMIT_ACTIVE_TIMEOUT_SECONDS=900
INTERVIEW_TASK_PROCESSING_TIMEOUT_SECONDS=900
INTERVIEW_TASK_HEARTBEAT_SECONDS=30

# Autonomous evolution is opt-in because it can trigger additional model calls.
EVOLUTION_ENABLED=false
EVOLUTION_TRIGGER_INTERVIEWS=10
EVOLUTION_SYNTHETIC_SAMPLES=10
EVOLUTION_JUDGE_MODEL=deepseek-flash
EVOLUTION_TASK_POLL_SECONDS=5
EVOLUTION_TASK_MAX_RETRIES=3
EVOLUTION_TASK_PROCESSING_TIMEOUT_SECONDS=3600
EVOLUTION_TASK_HEARTBEAT_SECONDS=30
EVOLUTION_OBSERVATION_INTERVIEWS=5

# Convenient for local development. Production deployments should normally run
# migrations as an explicit release step and set this to false.
AUTO_MIGRATE_ON_STARTUP=true

# Local HTTP development should set AUTH_COOKIE_SECURE=false.
# Production HTTPS deployments should keep it true.
AUTH_COOKIE_NAME=interview_arena_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=interview_arena_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOWED_ORIGIN_REGEX=
